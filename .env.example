# ---- LLM (agent brain) ----
ANTHROPIC_API_KEY=
SENTINEL_MODEL=claude-opus-5

# ---- Neo4j (dependency graph) — leave blank to use the in-memory graph ----
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- DuploCloud (governed execution plane) ----
DUPLO_BASE_URL=http://localhost:60031
DUPLO_TOKEN=
DUPLO_WORKSPACE_ID=
DUPLO_AGENT_ID=
DUPLO_SCOPE_IDS=
DUPLO_UI_URL=http://localhost:4210

# ---- Cloud executors ----
VULTR_API_KEY=
NEBIUS_IAM_TOKEN=
NEBIUS_PARENT_ID=

# ---- Behaviour ----
SENTINEL_AUTONOMY=earned      # auto | earned | approval
SENTINEL_TICK_SECONDS=2
SENTINEL_AUTO_CHAOS=true      # inject a random fault every ~90s for demo

# ---- Model orchestration via OpenRouter (pin to Nebius/Crusoe with a preset) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=@preset/duplo-nebius-glm

# ---- Brave Search (live advisory / docs checks) ----
BRAVE_API_KEY=
